{
  "name": "cloudpoc",
  "dockerComposeFile": "compose.yaml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/cloudpoc",
  "remoteUser": "dev",
  // UID-Anpassung übernimmt Podman (userns_mode: keep-id in compose.yaml)
  "updateRemoteUserUID": false,
  // Beim Schließen von VS Code beide Container stoppen (DB-Inhalt ist dann weg)
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "EditorConfig.EditorConfig",
        "bmewburn.vscode-intelephense-client",
        "Angular.ng-template"
      ]
    }
  }
}
