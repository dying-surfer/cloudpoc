# Repo-weite Regeln. Backend (Symfony) und Frontend (Angular) bringen
# eigene .gitignore-Dateien in ihren Unterordnern mit.

# Editor / OS
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store

# Lokale Konfiguration und Secrets – nie ins Repo
.env.local
.env.*.local
*.local.yaml
secrets/
# Ausnahme: mit sops verschlüsselte Kubernetes-Secrets (siehe .sops.yaml), nur *.sops.yaml
!deploy/secrets/
deploy/secrets/**
!deploy/secrets/**/
!deploy/secrets/**/*.sops.yaml

# DB-Dumps (können echte Daten enthalten)
db/dumps/
*.sql.gz
*.dump

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
