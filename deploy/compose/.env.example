# Vorlage für .env (liegt neben compose.yaml, wird von Compose automatisch gelesen).
#   cp .env.example .env   und dann die Werte setzen.
# .env enthält Secrets und gehört NIE ins Repo (steht in .gitignore).

# Passwort des DB-Users "app". Nur Hex-Zeichen, weil es auch in DATABASE_URL steht
# (Sonderzeichen müssten dort URL-kodiert werden). Erzeugen: openssl rand -hex 24
POSTGRES_PASSWORD=

# Symfony-Secret (u. a. für signierte URLs). Erzeugen: openssl rand -hex 32
APP_SECRET=

# Port auf dem Host (Standard 8088; 8000 ist das Dev-Backend, 4200 ng serve)
#HTTP_PORT=8088

# Andere Images, z. B. aus der Registry (Standard: lokal gebaute mit Tag "local")
#BACKEND_IMAGE=ghcr.io/…/cloudpoc-backend:<sha>
#FRONTEND_IMAGE=ghcr.io/…/cloudpoc-frontend:<sha>
